# ESPN league (private league auth). See README for how to find these.
ESPN_S2=your_espn_s2_cookie_here
SWID={YOUR-SWID-COOKIE-HERE}
LEAGUE_ID=123456
YEAR=2026
TEAM_ID=1

# AI chat agent. Default: uses your Claude subscription via the logged-in Claude Code app (no key needed).
# Optional: set an API key and CHAT_BACKEND=api to use the pay-per-use API instead.
# ANTHROPIC_API_KEY=
# CHAT_BACKEND=subscription
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional
CACHE_TTL_SECONDS=300

# Edge engine (optional; the app works without any of these)
# The Odds API free tier (~500 credits/month). Leave blank to use the Vegas lines already in the nflverse schedule (free).
ODDS_API_KEY=
# Cap on total adjustment per player per week: EDGE_CAP_PCT x max(ESPN projection, EDGE_CAP_FLOOR points)
EDGE_CAP_PCT=0.35
EDGE_CAP_FLOOR=6
